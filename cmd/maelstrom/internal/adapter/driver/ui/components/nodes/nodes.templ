package nodes

import "github.com/jonny7/maelstrom/cmd/maelstrom/internal/service/agent/dto"

templ status(status string) {
	switch status {
		case "alive":
			<span class="flex-shrink-0 inline-block px-2 py-0.5 text-green-800 text-xs font-medium bg-green-100 rounded-full">{ status }</span>
		case "failed":
			<span class="flex-shrink-0 inline-block px-2 py-0.5 text-red-800 text-xs font-medium bg-red-100 rounded-full">{ status }</span>
		case "leaving", "left":
			<span class="flex-shrink-0 inline-block px-2 py-0.5 text-yellow-800 text-xs font-medium bg-yellow-100 rounded-full">{ status }</span>
		default:
			<span class="flex-shrink-0 inline-block px-2 py-0.5 text-gray-800 text-xs font-medium bg-gray-100 rounded-full">{ status }</span>
	}
}

templ Nodes(nodes []dto.Member) {
	for _, node := range nodes {
		<ul>
			<li class="col-span-1 bg-white rounded-lg shadow divide-y divide-gray-200">
				<div class="w-full flex items-center justify-between p-6 space-x-6">
					<div class="flex-1 truncate">
						<div class="flex items-center space-x-3">
							<h3 class="text-gray-900 text-sm font-medium truncate">{ node.Name }</h3>
							@status(node.Status)
						</div>
						<p class="mt-1 text-gray-500 text-sm truncate">{ node.Addr }:{ node.Port }</p>
						<span class="flex-shrink-0 inline-block px-2 py-0.5 text-white-200 text-xs font-medium bg-purple-300 rounded-full">{ node.Tags }</span>
					</div>
				</div>
				<div>
					<div class="-mt-px flex divide-x divide-gray-200">
						<div class="w-0 flex-1 flex">
							<a href="#" class="relative -mr-px w-0 flex-1 inline-flex items-center justify-center py-4 text-sm text-white bg-blue-400 font-medium border border-transparent rounded-bl-lg">
								<svg class="w-5 h-5 text-white-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125"></path>
								</svg>
								<span class="ml-3">Update</span>
							</a>
						</div>
						<div class="w-0 flex-1 flex">
							<a href="#" class="relative -mr-px w-0 flex-1 inline-flex items-center justify-center py-4 text-sm text-white bg-red-400 font-medium border border-transparent rounded-br-lg">
								<svg class="w-5 h-5 text-white-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
								</svg>
								<span class="ml-3">Terminate</span>
							</a>
						</div>
					</div>
				</div>
			</li>
		</ul>
	}
}
